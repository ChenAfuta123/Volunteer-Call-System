<Window x:Class="PL.Call.CallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Call"
        mc:Ignorable="d"
        Title="CallWindow" Height="450" Width="800" DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">



    <Grid Margin="0,-1,0,1">
        <TextBox Grid.Row="0"  HorizontalAlignment="Left" Height="NaN" Margin="138,68,0,0"
        Text="{Binding CurrentCall.Id, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"
        IsReadOnly="{Binding ButtonText, Converter={StaticResource ConvertUpdateToTrueKey}}"
        VerticalAlignment="Top" Width="120"/>

        <TextBox 
         Text="{Binding CurrentCall.Address, Mode=TwoWay, NotifyOnValidationError=true,  ValidatesOnExceptions=true}"  HorizontalAlignment="Left" Height="NaN" Margin="138,119,0,0"  VerticalAlignment="Top" Width="120"/>
        <TextBox 
        Text="{Binding CurrentCall.Description, Mode=TwoWay, NotifyOnValidationError=true,  ValidatesOnExceptions=true}"  HorizontalAlignment="Left" Height="NaN" Margin="138,221,0,0"  VerticalAlignment="Top" Width="120"/>
      


      <ComboBox HorizontalAlignment="Left" Height="NaN" Margin="138,168,0,0" 
        ItemsSource="{Binding CallsCollection}" 
       SelectedValue="{Binding CurrentCall.callType, Mode=TwoWay, NotifyOnValidationError=true, 
        ValidatesOnExceptions=true}" 
       VerticalAlignment="Top" Width="120" />

        <DatePicker  SelectedDate="{Binding CurrentCall.MaxEndingTime, Mode=TwoWay, NotifyOnValidationError=true,  ValidatesOnExceptions=true}" HorizontalAlignment="Left" Margin="138,265,0,0" VerticalAlignment="Top" Width="120"/>
        <DatePicker IsEnabled="false"
        Visibility="{Binding ButtonText, Converter={StaticResource ConvertUpdateToVisibleKey}}"
        HorizontalAlignment="Left" Height="NaN" Margin="138,312,0,0"
        SelectedDate ="{Binding CurrentCall.OpeningTime, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"
        VerticalAlignment="Top" Width="120"/>


        <Label Content="" HorizontalAlignment="Left" Margin="51,68,0,0" VerticalAlignment="Top"/>
        <Label HorizontalAlignment="Left" Margin="56,114,0,0" VerticalAlignment="Top"/>
        <Label Content="Address:" HorizontalAlignment="Left" Margin="22,115,0,0" VerticalAlignment="Top"/>
        <Label Content="Call type:" HorizontalAlignment="Left" Margin="22,166,0,0" VerticalAlignment="Top"/>
        <Label Content="Description:" HorizontalAlignment="Left" Margin="22,217,0,0" VerticalAlignment="Top"/>
        <Label Content="Max Ending Time:" HorizontalAlignment="Left" Margin="22,263,0,0" VerticalAlignment="Top"/>

        <Label Content="Id:" Visibility="{Binding ButtonText, Converter={StaticResource ConvertUpdateToVisibleKey}}"
         HorizontalAlignment="Left" Margin="28,63,0,0" VerticalAlignment="Top"/>
        <Label Content="Opening time:"   Visibility="{Binding ButtonText, Converter={StaticResource ConvertUpdateToVisibleKey}}"
          HorizontalAlignment="Left" Margin="22,312,0,0" VerticalAlignment="Top"/>
        <Label Content="Call Status:" Visibility="{Binding ButtonText, Converter={StaticResource ConvertUpdateToVisibleKey}}"
        HorizontalAlignment="Left" Margin="26,351,0,0" VerticalAlignment="Top"/>
        <Button Content="{Binding ButtonText}" Click="btnAddUpdate_Click" HorizontalAlignment="Left" Margin="174,391,0,0" VerticalAlignment="Top" Width="48" Height="15" />
      

        
    </Grid>
</Window>
