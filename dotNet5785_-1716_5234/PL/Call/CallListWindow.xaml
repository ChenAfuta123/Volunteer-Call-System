<Window x:Class="PL.Call.CallListWindow" Loaded="Window_Loaded"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="1070" Height="2048"  
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Title="CallListWindow">
    <Grid Background="#ECEADB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Internal, Upper Grid -->
        <Grid Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#ECEADB">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sorting -->
            <Label Grid.Row="0" Grid.Column="0" Margin="10" Content=":מיון לפי" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" VerticalAlignment="Center" Margin="10,0,731,0" 
                      ItemsSource="{Binding Source={StaticResource CallsCollectionKey}}"
                      SelectedValue="{Binding CallSort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                      SelectionChanged="ComboBox_SelectionChanged"/>

            <!-- Filtering -->
            <Label Grid.Row="1" Grid.Column="0" Margin="10" Content=":סינון לפי" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,731,0" 
              ItemsSource="{Binding Source={StaticResource CallsCollectionKey}}"
              SelectedValue="{Binding CallFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
              SelectionChanged="ComboBox_SelectionChanged"/>

            <!-- Additional Filtering -->
            <Label Grid.Row="2" Grid.Column="0" Margin="10" Content=":סינון מותאם" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,731,0">
                <TextBox Width="200" VerticalAlignment="Center" Margin="5"
                 Text="{Binding CustomFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <Image Grid.Column="1" HorizontalAlignment="Left" Height="122" Margin="834,12,0,0" Grid.RowSpan="3" VerticalAlignment="Top" Width="122" Source="C:\Users\halle\OneDrive\שולחן העבודה\לוגו גדול.jpg"/>

        </Grid>

        <!-- DataGrid Section -->
        <DataGrid Grid.Row="1"  Background="#ECEADB" ItemsSource="{Binding CallList}" IsReadOnly="True" AutoGenerateColumns="False" 
                  EnableRowVirtualization="True" RowDetailsVisibilityMode="VisibleWhenSelected" 
                  MouseDoubleClick="dgCallList_MouseDoubleClick" SelectedItem="{Binding SelectedCall}" 
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Id}" Header="Volunteer ID" Width="*"/>
                <DataGridTextColumn Binding="{Binding CallId}" Header="Call Id" Width="*"/>
                <DataGridTextColumn Binding="{Binding callType}" Header="Call Type" Width="*"/>
                <DataGridTextColumn Binding="{Binding callStatus}" Header="Call Status" Width="*"/>
                <DataGridTextColumn Binding="{Binding OpeningTime}" Header="Opening Time" Width="*"/>
                <DataGridTextColumn Binding="{Binding RemainingCallTime}" Header="Remaining Call Time" Width="*"/>
                <DataGridTextColumn Binding="{Binding LastVolunteerName}" Header="Last Volunteer Name" Width="*"/>
                <DataGridTextColumn Binding="{Binding TotalHandlingTime}" Header="Total Handling Time" Width="*"/>
                <DataGridTextColumn Binding="{Binding TotalAllocations}" Header="Total Allocations" Width="*"/>

                <DataGridTemplateColumn Header="Delete" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Delete" Background="#AE90B6" Foreground="#ECEADB" BorderBrush="#AE90B6" Click="DeleteButton_Click" Width="75"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Cencel" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Cencel"  Background="#AEC494" Foreground="#ECEADB" BorderBrush="#AEC494" Click="CancelButton_Click" Width="75"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- Add Button -->
        <Grid Grid.Row="2" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Add" Click="btnAdd_Click" Grid.Column="1" HorizontalAlignment="Center" 
                    Height="50" Width="100" Margin="10"/>
        </Grid>
    </Grid>
</Window>