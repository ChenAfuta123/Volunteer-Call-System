<Window x:Class="PL.Call.CallListWindow" Loaded="Window_Loaded"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="1070" Height="2048"  DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
    Title="CallListWindow">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!--Internal, Upper Grid-->
        <Grid Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!--Sorting-->
            <Label Grid.Row="0" Grid.Column="0" Margin="10" Content="מיון לפי:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="10" ItemsSource="{Binding Source={StaticResource VolunteersCollectionKey}}"
             SelectedValue="{Binding CallSort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
             SelectionChanged="ComboBox_SelectionChanged"/>
            <!--Filtering-->
            <Label Grid.Row="1" Grid.Column="0" Margin="10" Content="סינון לפי:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="10" ItemsSource="{Binding Source={StaticResource VolunteersCollectionKey}}"
             SelectedValue="{Binding CallFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
             SelectionChanged="ComboBox_SelectionChanged"/>
        </Grid>
        <!--DataGrid Section-->
        <DataGrid Grid.Row="1" ItemsSource="{Binding CallList}" IsReadOnly="True" AutoGenerateColumns="False" EnableRowVirtualization="True" RowDetailsVisibilityMode="VisibleWhenSelected" MouseDoubleClick="dgCallList_MouseDoubleClick" SelectedItem="{Binding SelectedVolunteer}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Id}" Header="ID" Width="*"/>
                <DataGridTextColumn Binding="{Binding Name}" Header="Name" Width="*"/>
                <DataGridTextColumn Binding="{Binding Active}" Header="Active" Width="*"/>
                <DataGridTextColumn Binding="{Binding TotalHandledCalls}" Header="Total Handled Calls" Width="*"/>
                <DataGridTextColumn Binding="{Binding TotalCanceledCalls}" Header="Total Canceled Calls" Width="*"/>
                <DataGridTextColumn Binding="{Binding TotalExpiredCalls}" Header="Total Expired Calls" Width="*"/>
                <DataGridTextColumn Binding="{Binding HandledCallId}" Header="Handled Call ID" Width="*"/>
                <DataGridTemplateColumn Header="Actions" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Delete" Click="DeleteButton_Click" Width="75"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <!--Add Button-->
        <Button Content="Add" Click="btnAdd_Click" Grid.Row="2" HorizontalAlignment="Center" Height="50" Width="100" Margin="10"/>
    </Grid>
</Window>