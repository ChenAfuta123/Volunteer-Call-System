<Window x:Class="PL.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="800" Background="#ECEADB">
    <Grid Margin="10">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="מסך כניסה למערכת" FontSize="20" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,20" Foreground="#AEC494"/>


            <TextBlock Text="תעודת זהות:"/>
            <TextBox x:Name="IdTextBox" Width="200" Margin="0,0,0,10"/>

            <TextBlock Text="סיסמה:"/>
            <PasswordBox x:Name="PasswordBox" Width="200" Margin="0,0,0,20"/>

            <Button Content="כניסה" Click="LoginButton_Click" Foreground="Black" Background="#AE90B6" Width="100" Height="30" HorizontalAlignment="Center"/>

        </StackPanel>
        <!--<Image HorizontalAlignment="Left" Height="100" VerticalAlignment="Top" Width="100" Source="C:\Users\User\OneDrive\Desktop.jpg"/>-->
    </Grid>
</Window>