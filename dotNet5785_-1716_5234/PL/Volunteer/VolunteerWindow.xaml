<Window x:Class="PL.Volunteer.VolunteerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="חלון מתנדב" Height="600" Width="800" DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Background="#FFFFFF">
    <Window.Resources>
        <!-- סגנון לטקסטבוקסים -->
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="BorderBrush" Value="#7AB9E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Width" Value="250"/>
        </Style>

        <!-- סגנון לכפתורים -->
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="BorderBrush" Value="#005B99"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <!-- סגנון לתוויות -->
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#005B99"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>

        <!-- סגנון לקומבובוקסים -->
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="BorderBrush" Value="#7AB9E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Width" Value="250"/>
        </Style>

        <!-- סגנון לצ'קבוקס -->
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#005B99"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>

        <!-- סגנון ל-PasswordBox -->
        <Style TargetType="PasswordBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="BorderBrush" Value="#7AB9E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Width" Value="250"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <Label Content="ת.ז:" Width="120"/>
                <TextBox Text="{Binding CurrentVolunteer.Id}" IsReadOnly="{Binding ButtonText, Converter={StaticResource ConvertUpdateToTrueKey}}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="שם:" Width="120"/>
                <TextBox Text="{Binding CurrentVolunteer.Name}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="טלפון:" Width="120"/>
                <TextBox Text="{Binding CurrentVolunteer.PhoneNumber}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="אימייל:" Width="120"/>
                <TextBox Text="{Binding CurrentVolunteer.Email}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="תפקיד:" Width="120"/>
                <ComboBox ItemsSource="{Binding Source={StaticResource RoleCollectionKey}}" SelectedValue="{Binding CurrentVolunteer.role}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="כתובת:" Width="120"/>
                <TextBox Text="{Binding CurrentVolunteer.Address}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="מרחק מקסימלי:" Width="120"/>
                <TextBox Text="{Binding CurrentVolunteer.MaxDistance}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="סיסמה:" Width="120"/>
                <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="פעיל" IsChecked="{Binding CurrentVolunteer.Active}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="סוג מרחק:" Width="120"/>
                <ComboBox ItemsSource="{Binding Source={StaticResource DistanceTypeCollectionKey}}" SelectedValue="{Binding CurrentVolunteer.distanceType}"/>
            </StackPanel>
        </StackPanel>

        <Button Grid.Row="1" Content="עדכון" Click="btnAddUpdate_Click" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
    </Grid>
</Window>