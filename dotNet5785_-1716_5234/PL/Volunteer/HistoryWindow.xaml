<Window x:Class="PL.Volunteer.HistoryWindow" Loaded="Window_Loaded" Closed="Window_Closed"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Volunteer"
        mc:Ignorable="d"
        Title="היסטוריית קריאות" Height="600" Width="800" FlowDirection="RightToLeft" DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}" Background="#ECEADB">

    <Grid>
        <StackPanel Orientation="Vertical" Margin="10">
            <StackPanel Orientation="Horizontal" Height="77" Width="793">
                <!-- Label for Filter ComboBox -->
                <Label Content="סינון" VerticalAlignment="Center" Margin="5"/>
                <ComboBox 
          SelectedValue="{Binding CallFilter, Mode=TwoWay}"
          SelectedValuePath="Tag"
          SelectionChanged="ComboBox_SelectionChanged" 
          Width="195" Height="27">
                    <ComboBoxItem Content="כל הקריאות" Tag="None"/>
                    <ComboBoxItem Content="אספקה חיונית" Tag="EssentialSupplies"/>
                    <ComboBoxItem Content="דיור והעברה" Tag="HousingAndRelocation"/>
                    <ComboBoxItem Content="תמיכה רגשית-חברתית" Tag="EmotionalAndSocialSupport"/>
                    <ComboBoxItem Content="סיוע רפואי-תרופתי" Tag="MedicalAndPharmaceuticalAid"/>
                    <ComboBoxItem Content="סיוע משפטי-מנהלתי" Tag="LegalAndAdministrativeSupport"/>
                </ComboBox>

                <!-- Label for Sort ComboBox -->
                <Label Content="מיון" VerticalAlignment="Center" Margin="5"/>
                <ComboBox x:Name="SortComboBox"  SelectedValue="{Binding CallSort, Mode=TwoWay}"  SelectedValuePath="Tag" 
                          SelectionChanged="ComboBox_SelectionChanged" Width="191" Margin="5" Height="28">
                    <ComboBoxItem Content="ללא מיון" Tag="None"/>
                    <ComboBoxItem Content="לפי תז" Tag="Id"/>
                    <ComboBoxItem Content="לפי כתובת" Tag="Address"/>
                    <ComboBoxItem Content="לפי זמן פתיחה" Tag="OpeningTime"/>
                    <ComboBoxItem Content="לפי זמן סיום" Tag="EndTime"/>
                </ComboBox>
            </StackPanel>
            <DataGrid ItemsSource="{Binding ClosedCallInList}" AutoGenerateColumns="False"      
                      >
                <DataGrid.Columns>
                    <DataGridTextColumn Header="מזהה קריאה" Binding="{Binding Id}" Width="*"/>
                    <DataGridTextColumn Header="סוג קריאה" Binding="{Binding callType}" Width="*"/>
                    <DataGridTextColumn Header="כתובת" Binding="{Binding Address}" Width="*"/>
                    <DataGridTextColumn Header="זמן פתיחה" Binding="{Binding OpeningTime}" Width="*"/>
                    <DataGridTextColumn Header="זמן סיום" Binding="{Binding EndTime}" Width="*"/>
                    <DataGridTextColumn Header="סוג סיום" Binding="{Binding EndTimeType}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- DataGrid -->
        </StackPanel>
        <Image HorizontalAlignment="Left" Height="81" Margin="725,0,0,0" VerticalAlignment="Top" Width="108" Source="C:\Users\User\OneDrive\Desktop\לוגו גדול.jpg"/>
    </Grid>
</Window>