<Window x:Class="PL.Volunteer.CallSelectionWindow" Loaded="Window_Loaded"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="בחירת קריאה לטיפול" Height="600" Width="800" Background="#FFFFFF"   DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- אזור הסינון והמיון -->
        <StackPanel Orientation="Horizontal" Margin="10" Grid.Row="0">
            <TextBlock Text="סינון לפי:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox  Width="150"
             ItemsSource="{Binding Source={StaticResource OpenCallsCollectionKey}}"
             SelectedValue="{Binding CallFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             SelectionChanged="ComboBox_SelectionChanged"/>
            <TextBlock Text="מיון לפי:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox  Width="150"
                ItemsSource="{Binding Source={StaticResource OpenCallsCollectionKey}}"
                SelectedValue="{Binding CallSorter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                SelectionChanged="ComboBox_SelectionChanged"/>

        </StackPanel>
        <!-- DataGrid -->
        <DataGrid x:Name="OpenCallsDataGrid" Grid.Row="1" AutoGenerateColumns="False" Margin="10" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="מזהה" Binding="{Binding Id}" />
                <DataGridTextColumn Header="סוג הקריאה" Binding="{Binding callType}" />
                <DataGridTextColumn Header="תיאור" Binding="{Binding description}" />
                <DataGridTextColumn Header="כתובת" Binding="{Binding Address}" />
                <DataGridTextColumn Header="זמן פתיחה" Binding="{Binding OpeningTime, StringFormat=dd/MM/yyyy HH:mm}" />
                <DataGridTextColumn Header="זמן סיום מקסימלי" Binding="{Binding maxEndingTime, StringFormat=dd/MM/yyyy HH:mm}" />
                <DataGridTextColumn Header="מרחק מהמתנדב" Binding="{Binding CallDistanceFromVolunteer, StringFormat=F2}" />
                <DataGridTemplateColumn Header="פעולה">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="טיפול" Click="TreatmentButton_Click" Tag="{Binding}" />
                            <!--<Button Content="פרטי קריאה" Click="DescriptionButton_Click" Tag="{Binding}" />-->
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>