<Window x:Class="PL.Volunteer.CallSelectionWindow" Loaded="Window_Loaded" Closed="Window_Closed"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="בחירת קריאה לטיפול" Height="600" Width="800" Background="#ECEADB"   
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">

    <Window.Resources>
        <!-- הגדרת CollectionViewSource עבור OpenCalls -->

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- אזור הסינון והמיון -->
        <StackPanel Orientation="Horizontal" Margin="10,10,0,10" Grid.Row="0" HorizontalAlignment="Left" Width="521">
            <TextBlock Text="סינון לפי:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="FiltererComboBox" SelectedValue="{Binding CallFilter, Mode=TwoWay}" 
          SelectedValuePath="Tag" Width="200" Margin="5">
                <ComboBoxItem Content=" Id" Tag="Id"/>
                <ComboBoxItem Content="callType" Tag="callType"/>
                <ComboBoxItem Content="Description" Tag="Description"/>
                <ComboBoxItem Content="Address" Tag="Address"/>
                <ComboBoxItem Content="Opening Time" Tag="OpeningTime"/>
                <ComboBoxItem Content="Max Ending Time" Tag="MaxEndingTime"/>
                <ComboBoxItem Content="Call Distance From Volunteer" Tag="CallDistanceFromVolunteer"/>
                <ComboBoxItem Content="None" Tag="None"/>
            </ComboBox>
            <TextBlock Text="מיון לפי:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="SorterComboBox" SelectedValue="{Binding CallSorter, Mode=TwoWay}" 
          SelectedValuePath="Tag" Width="200" Margin="5">
                <ComboBoxItem Content=" Id" Tag="Id"/>
                <ComboBoxItem Content="callType" Tag="callType"/>
                <ComboBoxItem Content="Description" Tag="Description"/>
                <ComboBoxItem Content="Address" Tag="Address"/>
                <ComboBoxItem Content="Opening Time" Tag="OpeningTime"/>
                <ComboBoxItem Content="Max Ending Time" Tag="MaxEndingTime"/>
                <ComboBoxItem Content="Call Distance From Volunteer" Tag="CallDistanceFromVolunteer"/>
                <ComboBoxItem Content="None" Tag="None"/>
            </ComboBox>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid ItemsSource="{Binding OpenCallList}" Grid.Row="1" AutoGenerateColumns="False" Margin="10,61,10,10" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="מזהה" Binding="{Binding Id}" />
                <DataGridTextColumn Header="סוג הקריאה" Binding="{Binding callType}" />
                <DataGridTextColumn Header="תיאור" Binding="{Binding description}" />
                <DataGridTextColumn Header="כתובת" Binding="{Binding Address}" />
                <DataGridTextColumn Header="זמן פתיחה" Binding="{Binding OpeningTime, StringFormat=dd/MM/yyyy HH:mm}" />
                <DataGridTextColumn Header="זמן סיום מקסימלי" Binding="{Binding maxEndingTime, StringFormat=dd/MM/yyyy HH:mm}" />
                <DataGridTextColumn Header="מרחק מהמתנדב" Binding="{Binding CallDistanceFromVolunteer, StringFormat=F2}" />
                <DataGridTemplateColumn Header="פעולה">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="טיפול" Click="TreatmentButton_Click"  />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Image HorizontalAlignment="Left" Height="100" Margin="697,10,0,0" Grid.RowSpan="2" VerticalAlignment="Top" Width="100" Source="C:\Users\User\OneDrive\Desktop\לוגו גדול.jpg"/>
    </Grid>
</Window>